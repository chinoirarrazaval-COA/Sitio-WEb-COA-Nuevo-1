{% if section.settings.desktop_image != blank or section.settings.mobile_image != blank %}
<div class="responsive-banner">
  {% if section.settings.url_banner != blank %}
    <a href="{{ section.settings.url_banner }}" class="banner-link">
  {% endif %}

  {% assign image_alt = section.settings.desktop_image.alt | default: section.settings.mobile_image.alt %}

  {% if section.settings.desktop_image != blank and section.settings.mobile_image != blank %}
    <picture>
      <source media="(max-width: 768px)"
        srcset="{{ section.settings.mobile_image | image_url: width: 640 }} 640w, {{ section.settings.mobile_image | image_url: width: 900 }} 900w, {{ section.settings.mobile_image | image_url: width: 1200 }} 1200w"
        sizes="100vw">
      <source media="(min-width: 769px)"
        srcset="{{ section.settings.desktop_image | image_url: width: 900 }} 900w, {{ section.settings.desktop_image | image_url: width: 1400 }} 1400w, {{ section.settings.desktop_image | image_url: width: 1800 }} 1800w"
        sizes="100vw">
      <img src="{{ section.settings.desktop_image | image_url: width: 1400 }}"
        alt="{{ image_alt | escape }}"
        loading="lazy"
        class="responsive-banner__image">
    </picture>
  {% elsif section.settings.desktop_image != blank %}
    <img src="{{ section.settings.desktop_image | image_url: width: 1400 }}"
      alt="{{ section.settings.desktop_image.alt | escape }}"
      loading="lazy"
      class="responsive-banner__image">
  {% elsif section.settings.mobile_image != blank %}
    <img src="{{ section.settings.mobile_image | image_url: width: 900 }}"
      alt="{{ section.settings.mobile_image.alt | escape }}"
      loading="lazy"
      class="responsive-banner__image">
  {% endif %}

  {% if section.settings.url_banner != blank %}
    </a>
  {% endif %}
</div>
<style>
.responsive-banner {
  width: 100%;
  position: relative;
  overflow: hidden;
}
.responsive-banner__image {
  width: 100%;
  height: auto;
  display: block;
}
</style>
{% endif %}
{% schema %}
{
"name": "Banner Responsive",
"settings": [
{
"type": "header",
"content": "Desktop Banner"
},
{
"type": "url",
"id": "url_banner",
"label": "URL button",
"default": "/collections/all"
},
{
"type": "image_picker",
"label": "Desktop Image",
"id": "desktop_image"
},
{
"type": "header",
"content": "Mobile Banner"
},
{
"type": "image_picker",
"label": "Mobile Image",
"id": "mobile_image"
}
],
"presets": [
{
"name": "Banner Responsive",
"category": "Image",
"settings": {
}
}
]
}
{% endschema %}