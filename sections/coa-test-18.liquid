  .ct-code{font-family:ui-monospace,Menlo,monospace;font-weight:700;font-size:clamp(22px,6vw,30px);letter-spacing:.1em;color:var(--ct-yellow);border:1px dashed var(--ct-yellow);padding:16px;text-align:center;margin:4px 0 16px}
  .ct-share{margin-top:12px;font-size:14px;color:var(--ct-muted)}

  .ct-foot{margin-top:36px;padding-top:22px;border-top:1px solid var(--ct-line);font-size:13px;color:var(--ct-muted);line-height:1.6}
  .ct-foot strong{color:var(--ct-ink);font-weight:700}

  .ct-screen{display:none}
  .ct-screen.on{display:block}
  @media (prefers-reduced-motion:reduce){.coatest *{transition:none!important}}

  .ct-cardbox{text-align:center}
  .ct-cardbox canvas{width:100%;max-width:236px;height:auto;display:block;margin:0 auto 16px;border:1px solid var(--ct-line);background:var(--ct-ground)}
  .ct-cardhint{font-size:14px;color:var(--ct-muted);margin-top:12px!important}
  .ct-cardhint b{color:var(--ct-ink)}
</style>

