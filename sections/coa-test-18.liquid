  .ct-opt{position:relative;display:block;width:100%;text-align:left;background:var(--ct-surface);color:var(--ct-ink);border:1px solid var(--ct-line);padding:15px 17px;font-size:16px;line-height:1.4;transition:background .12s,border-color .12s}
