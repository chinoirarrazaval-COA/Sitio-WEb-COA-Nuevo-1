  .ct-rec{display:block;margin-top:4px;font-size:10px;opacity:.7}

  .ct-word{font-family:ui-monospace,Menlo,monospace;font-weight:700;font-size:clamp(24px,7vw,38px);line-height:1.1;letter-spacing:-.02em;margin:0 0 6px;color:var(--ct-ink)}
