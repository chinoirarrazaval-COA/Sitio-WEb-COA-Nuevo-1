  .coatest button{font-family:inherit;font-size:inherit;cursor:pointer}
  .ct-btn{display:block;width:100%;background:var(--ct-red);color:#fff;border:0;padding:17px 20px;font-weight:900;font-size:15px;letter-spacing:.08em;text-transform:uppercase;transition:filter .15s ease}
  .ct-btn:hover{filter:brightness(1.12)}
  .ct-btn--ghost{background:transparent;color:var(--ct-ink);border:1px solid var(--ct-line);font-weight:700}
  .ct-btn--ghost:hover{background:var(--ct-surface2);filter:none}

  .ct-tally{display:flex;gap:14px;align-items:flex-end;height:30px}
