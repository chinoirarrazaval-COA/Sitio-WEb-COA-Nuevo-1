<script>
(function(){
  "use strict";
  var root = document.getElementById("coatest18");
  if (!root) return;
  function el(n){ return root.querySelector('[data-el="'+n+'"]'); }
  function screen(n){ return root.querySelector('[data-s="'+n+'"]'); }

  var BANK = [
    ["Chicha en cacho","Chicha servida en un cuerno de vaca",["Chicha con mucho grado","Chicha hecha en la casa","Un vaso grande de chicha"],"«Nos tomamos una chicha en cacho en la ramada.»",null],
    ["Un terremoto","Pipeño con helado de piña",["Pisco con helado de piña","Chicha con granadina","Vino tinto con fruta"],"«Uno solo y ya andái chueco.»",null],
    ["La réplica","El segundo terremoto, de medio vaso",["La segunda vuelta de la cueca","Cuando repiten la canción","El último brindis de la noche"],"«Después del terremoto viene la réplica. Y ahí se acabó el 18.»",null],
    ["El pipeño","Vino artesanal, joven y turbio",["Chicha de manzana","Aguardiente de uva","Vino hervido con canela"],"«Traje un chuico de pipeño del sur.»",null],
    ["El hilo curado","Hilo con vidrio molido para cortar volantines",["Hilo pasado por cera","Hilo de tres hebras","Hilo bendecido antes de volar"],"«Con hilo curado te cortan el volantín en dos segundos.»",null],
    ["El emboque","El juguete de palo y bola",["El trompo chico","La payaya","El zumbador"],"«Le achuntó al emboque a la primera.»",null],
    ["Una ramada","La fonda con techo de ramas",["La fonda sin permiso","La pista de baile","El puesto de anticuchos"],"«Ramada es por las ramas del techo, no por otra cosa.»",null],
    ["Un malón","Una fiesta donde cada uno lleva algo",["Una fiesta sorpresa","Un asado de la pega","Una pelea en la fonda"],"«Hagamos un malón: yo pongo la carne, tú el trago.»",null],
    ["Un chuico","El damajuana forrado en mimbre",["El barril chico","Un jarro de greda","La copa del brindis"],"«Se acabó el chuico antes del almuerzo.»",null],
    ["Un pie de cueca","Cada vuelta completa del baile",["El zapateo","El primer paso","El paso del pañuelo"],"«La cueca se baila de a tres pies, no uno.»",null],
    ["La cueca brava","La cueca urbana, de bar y no de fundo",["La cueca que se baila más rápido","La cueca del norte","La cueca que se baila descalzo"],"«La cueca brava es de Santiago y Valparaíso, no del campo.»",null],
    ["Andar pato","Andar sin plata",["Andar mojado","Andar solo","Andar lento"],"«Ando pato hasta el día 5.»",null],
    ["Ponerse con algo","Aportar con plata o con algo",["Ponerse de acuerdo","Empezar a pelear","Ponerse serio"],"«Pónganse con algo para el asado.»",null],
    ["Echar la foca","Retar fuerte a alguien",["Vomitar","Tirar mala onda","Echar a alguien del trabajo"],"«Me echó la foca por llegar tarde.»",null],
    ["Un patiperro","El que anda siempre viajando",["El que anda descalzo","El perro de la calle","El que llega tarde a todo"],"«Chileno patiperro: no hay país donde no haya uno.»",null],
    ["Un cahuín","Un chisme o un enredo",["Una pelea","Una fiesta chica","Un trago fuerte"],"«No me metái en cahuines.»",null],
    ["Un cachureo","Cosas viejas que uno guarda",["Un desorden","Una feria libre","Un trabajo malo"],"«Tengo el patio lleno de cachureos.»",null],
    ["Sacar pica","Provocar envidia a propósito",["Enojarse","Sacar la vuelta","Reclamar por todo"],"«Anda sacando pica con el auto nuevo.»",null],
    ["La guita","La plata",["Una cuerda","Un cigarro","Una pelea"],"«No queda guita hasta fin de mes.»",["Esta es coa, no chilenismo →","El diccionario completo","/pages/jerga-coa"]],
    ["Coronar","Tener éxito",["Ser el jefe","Salir libre","Terminar la pega"],"«Coronó con el negocio, le fue bien.»",["Hay un plan que se llama así →","Únete al Plan pa Coronar","/products/plan-pa-coronar-20-000"]]
  ];

  var TIERS = [
    {min:10, rank:"Chileno con denominación de origen", text:"Diez de diez. Esto no se estudia, esto se vive. Andá a cobrar tu premio a la fonda."},
    {min:7,  rank:"Chileno de tomo y lomo",             text:"Siete u ocho. Te criaste acá y se nota. Las que fallaste son las que ya casi nadie usa."},
    {min:4,  rank:"Medio agringado",                    text:"Mitad y mitad. Sabes lo que sale en la tele, pero lo que se habla en la mesa todavía no."},
    {min:0,  rank:"Perkin con bandera",                 text:"Te pusiste la bandera en el auto y hasta ahí llegaste. La buena noticia: ahora sabes diez palabras más."}
  ];

  var SLUG = ["denominacion-origen","tomo-y-lomo","medio-agringado","perkin-con-bandera"];
  var CODE = "CHILENO18";
  var URL  = "https://coasurf.com/pages/que-tan-chileno-eri";

  var TOTAL = 10;
  var qs=[], idx=0, hits=0, locked=false, missed=[], best=null, tier=null, tierIx=3, intento=0;

  function readBest(){ try{ var v=localStorage.getItem("coa18_best"); return v===null?null:parseInt(v,10);}catch(e){return null;} }
  function writeBest(v){ try{ localStorage.setItem("coa18_best",String(v)); }catch(e){} }
  function readNum(k){ try{ var v=localStorage.getItem(k); return v===null?0:parseInt(v,10)||0; }catch(e){ return 0; } }
  function writeNum(k,v){ try{ localStorage.setItem(k,String(v)); }catch(e){} }
  function enviado(){ try{ return localStorage.getItem("coa18_enviado"); }catch(e){ return null; } }

  function shuffle(a){ a=a.slice(); for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;} return a; }

  function build(){
    qs = shuffle(BANK).slice(0,TOTAL).map(function(r){
      return {word:r[0], right:r[1], opts:shuffle([r[1]].concat(r[2])), use:r[3], tie:r[4]};
    });
    idx=0; hits=0; locked=false; missed=[];
  }

  function drawTally(){
    var box = el("tally"); box.innerHTML="";
    for (var g=0;g<2;g++){
      var svg=document.createElementNS("http://www.w3.org/2000/svg","svg");
      svg.setAttribute("width","46"); svg.setAttribute("height","28"); svg.setAttribute("viewBox","0 0 46 28");
      for (var s=0;s<5;s++){
        var n=g*5+s, cls="s";
        if(n<idx) cls+=" on"; else if(n===idx) cls+=" now";
        var ln=document.createElementNS("http://www.w3.org/2000/svg","line");
        if(s<4){ var x=5+s*8; ln.setAttribute("x1",x); ln.setAttribute("y1","3"); ln.setAttribute("x2",x); ln.setAttribute("y2","25"); }
        else { ln.setAttribute("x1","1"); ln.setAttribute("y1","24"); ln.setAttribute("x2","33"); ln.setAttribute("y2","4"); }
        ln.setAttribute("class",cls); svg.appendChild(ln);
      }
      box.appendChild(svg);
    }
  }

  function render(){
    var q=qs[idx]; locked=false;
    el("qnum").textContent = "Pregunta "+(idx+1)+" de "+TOTAL;
    el("hits").textContent = hits+(hits===1?" buena":" buenas");
    el("recLive").textContent = best===null ? "" : "récord "+best+"/10";
    el("word").textContent = q.word;
    el("after").classList.remove("show");
    drawTally();
    var box=el("opts"); box.innerHTML="";
    q.opts.forEach(function(t){
      var b=document.createElement("button");
      b.className="ct-opt"; b.type="button"; b.textContent=t;
      b.addEventListener("click", function(){ answer(b,t,q); });
      box.appendChild(b);
    });
  }

  function answer(btn,picked,q){
    if(locked) return; locked=true;
    var good = picked===q.right;
    if(good) hits++; else missed.push(q);
    Array.prototype.forEach.call(el("opts").children, function(o){
      o.disabled=true;
      if(o.textContent===q.right){
        o.classList.add("ok");
        if(!good){ var t=document.createElement("span"); t.className="tg"; t.textContent="Esta era"; o.appendChild(t); }
      } else if(o===btn){ o.classList.add("bad"); }
    });
    el("hits").textContent = hits+(hits===1?" buena":" buenas");
    var note=el("note");
    note.textContent = "«"+q.word+"» es "+q.right.toLowerCase()+".";
    var use=document.createElement("span"); use.className="use"; use.textContent=q.use; note.appendChild(use);
    if(q.tie){
      var tie=document.createElement("span"); tie.className="tie";
      var a=document.createElement("a"); a.href=q.tie[2]; a.textContent=q.tie[1];
      tie.appendChild(document.createTextNode(q.tie[0]+" ")); tie.appendChild(a);
      note.appendChild(tie);
    }
    el("next").textContent = (idx===TOTAL-1) ? "Ver mi resultado" : "Siguiente";
    el("after").classList.add("show");
  }

  function go(n){
    ["intro","quiz","result"].forEach(function(s){ screen(s).classList.toggle("on", s===n); });
    root.scrollIntoView({behavior:"smooth", block:"start"});
  }

  function finish(){
    tierIx = 0;
    while (tierIx < TIERS.length && hits < TIERS[tierIx].min) tierIx++;
    if (tierIx >= TIERS.length) tierIx = TIERS.length - 1;
    tier = TIERS[tierIx];
    intento = readNum("coa18_intentos") + 1;
    writeNum("coa18_intentos", intento);
    var prev=best;
    if(best===null || hits>best){ best=hits; writeBest(hits); }
    el("rank").textContent = tier.rank.toUpperCase();
    el("final").textContent = hits;
    el("shareScore").textContent = hits;
    el("verdict").textContent = tier.text;
    cardReady = false; buildCard();
    el("codeBox").textContent = CODE;
    var rn=el("recNote");
    if(prev!==null && hits>prev) rn.textContent="· récord nuevo, antes "+prev;
    else if(prev!==null) rn.textContent="· tu récord es "+prev;
    else rn.textContent="";

    var mb=el("missedBox"), ml=el("missed"); ml.innerHTML="";
    if(missed.length){
      missed.forEach(function(q){
        var li=document.createElement("li");
        var w=document.createElement("span"); w.className="w"; w.textContent=q.word;
        var m=document.createElement("span"); m.className="m"; m.textContent=q.right;
        li.appendChild(w); li.appendChild(m); ml.appendChild(li);
      });
      mb.style.display="";
    } else { mb.style.display="none"; }

    var ya = enviado();
    if (ya){
      el("prizeText").textContent = "Ya estás dentro con " + ya + "/10. Ese es el que corre para el sorteo. Tu código sigue abajo.";
      el("prize").style.display="none";
      el("reveal").style.display="";
      el("cardbox").style.display="";
      setRevealText(ya);
    } else {
      if (intento > 1){
        el("prizeText").textContent = "Este es tu intento N°" + intento + ". Puedes mandarlo igual y llevarte el 15%, pero al sorteo solo entra el primer intento de cada persona.";
      } else {
        el("prizeText").textContent = (hits === 10
          ? "Sacaste 10 de 10, as\u00ed que est\u00e1s dentro del sorteo de la polera. Deja tu correo para quedar inscrito \u2014 sin eso no entras. De paso te mando el 15% para la tienda."
          : "Al sorteo de la polera entran todos los que saquen 10/10. Te faltaron " + (10-hits) + ". Deja tu correo igual y te llevas el 15% \u2014 y si vuelves a jugar y sacas 10, quedas dentro.");
      }
      el("prize").style.display=""; el("reveal").style.display="none";
      el("cardbox").style.display="none";
    }
    document.getElementById("ct18-mail").value="";
    document.getElementById("ct18-ok").checked=false;
    el("err").classList.remove("show");
    el("claim").disabled=false;
    go("result");
  }

  function setRevealText(n){
    var t = el("revealText"); if(!t) return;
    n = Number(n);
    t.textContent = (n === 10)
      ? "Quedaste inscrito en el sorteo de la polera con 10/10. El lunes 21 sorteamos entre todos los que sacaron 10."
      : "Quedaste con " + n + "/10. Al sorteo entran los 10/10, así que si quieres estar, vuelve a jugar — pero tu código ya es tuyo.";
  }

  function post(fields){
    var fd = new FormData();
    fd.append("utf8","✓");
    Object.keys(fields).forEach(function(k){ fd.append(k, fields[k]); });
    return fetch("/contact", {method:"POST", body:fd, headers:{"Accept":"text/html"}});
  }

  var MAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  el("start").addEventListener("click", function(){ build(); render(); go("quiz"); });
  el("again").addEventListener("click", function(){ build(); render(); go("quiz"); });
  el("next").addEventListener("click", function(){
    if(idx===TOTAL-1){ finish(); return; }
    idx++; render();
  });

  el("claim").addEventListener("click", function(){
    var v=document.getElementById("ct18-mail").value.trim(), err=el("err");
    if(!MAIL.test(v)){ err.textContent="Ese correo no se ve bien. Revísalo y prueba de nuevo."; err.classList.add("show"); return; }
    if(!document.getElementById("ct18-ok").checked){ err.textContent="Marca la casilla para que podamos mandarte el código."; err.classList.add("show"); return; }
    err.classList.remove("show");
    el("claim").disabled=true;
    post({"form_type":"customer","contact[email]":v,
      "contact[tags]":"newsletter,test-18,"+CODE+",intento-"+intento+",puntaje18-"+hits+",rango-"+SLUG[tierIx]+(intento===1?",sorteo18-valido":",fuera-de-sorteo")});
    try{ localStorage.setItem("coa18_enviado", String(hits)); }catch(e){}
    setRevealText(hits);
    el("prize").style.display="none";
    el("reveal").style.display="";
    el("cardbox").style.display="";
    el("reveal").scrollIntoView({behavior:"smooth", block:"center"});
  });

  function shareText(){
    return "Saqué "+hits+"/10 en el test «¿Qué tan chileno erí?» de COA. Salí "+tier.rank+". ¿Te atreves? "+URL;
  }
  el("copy").addEventListener("click", function(){
    var txt=shareText();
    if(navigator.share){
      navigator.share({title:"¿Qué tan chileno erí?", text:txt, url:URL}).catch(function(){});
      return;
    }
    var done=function(){ el("copy").textContent="Copiado"; };
    if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(txt).then(done,done); }
    else { done(); }
  });
  el("wsp").addEventListener("click", function(){
    window.open("https://wa.me/?text="+encodeURIComponent(shareText()),"_blank","noopener");
  });

  /* ---- tarjeta de resultado para historias ---- */
  var COA_LOGO = "data:image/png;base64,";
  var BLACKF = '"Archivo Black","Arial Black",Arial,sans-serif';
  var MONOF  = 'ui-monospace,Menlo,Consolas,"Courier New",monospace';
  var cardReady = false, logoImg = null;

  function loadFont(cb){
    if (!document.fonts || !document.fonts.load) return cb();
    if (document.fonts.check('40px "Archivo Black"')) return cb();
    if (!document.getElementById("coa-ab-font")){
      var l = document.createElement("link");
      l.id = "coa-ab-font"; l.rel = "stylesheet";
      l.href = "https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap";
      document.head.appendChild(l);
    }
    var fired = false, fin = function(){ if(!fired){ fired = true; cb(); } };
    setTimeout(fin, 2500);
    document.fonts.load('40px "Archivo Black"').then(fin, fin);
  }

  function ctxWrap(ctx, text, maxw){
    var words = text.split(" "), lines = [], cur = "";
    for (var i=0;i<words.length;i++){
      var t = cur ? cur+" "+words[i] : words[i];
      if (ctx.measureText(t).width <= maxw) cur = t;
      else { if (cur) lines.push(cur); cur = words[i]; }
    }
    if (cur) lines.push(cur);
    return lines;
  }
  function trackedW(ctx, t, tr){
    var w = 0;
    for (var i=0;i<t.length;i++) w += ctx.measureText(t[i]).width + (i<t.length-1?tr:0);
    return w;
  }
  function trackedC(ctx, t, cx, y, tr){
    var x = cx - trackedW(ctx, t, tr)/2;
    for (var i=0;i<t.length;i++){ ctx.fillText(t[i], x, y); x += ctx.measureText(t[i]).width + tr; }
  }

  function paintCard(){
    var cv = el("canvas"); if (!cv || !cv.getContext) return;
    var ctx = cv.getContext("2d");
    var W = 1080, H = 1920, M = 90, CW = W - 2*M, CX = W/2;
    var GROUND = "#131110", INK = "#f0ebe6", MUTED = "#948a83", RED = "#e22120", YELLOW = "#f4d400";

    ctx.clearRect(0,0,W,H);
    ctx.fillStyle = GROUND; ctx.fillRect(0,0,W,H);
    ctx.textBaseline = "top"; ctx.textAlign = "left";

    if (logoImg && logoImg.complete && logoImg.naturalHeight){
      var lh = 160, lw = Math.round(logoImg.naturalWidth * lh / logoImg.naturalHeight);
      ctx.drawImage(logoImg, Math.round((W-lw)/2), 140, lw, lh);
    }

    var eye = "\u00bfQU\u00c9 TAN CHILENO ER\u00cd?";
    var score = hits + "/10";
    var rankTxt = (tier ? tier.rank : "").toUpperCase();
    var verdict = tier ? tier.text : "";

    ctx.font = '29px ' + MONOF;
    var EYE_H = 36, GAP_EYE = 70, SCORE_H = 210, GAP_SCORE = 50;
    var RANK_SZ = 88, RANK_LH = Math.round(RANK_SZ*1.04), GAP_RANK = 66;
    var RULE_H = 8, GAP_RULE = 64, V_LH = 54;

    ctx.font = RANK_SZ + 'px ' + BLACKF;
    var rlines = ctxWrap(ctx, rankTxt, CW);
    ctx.font = '35px ' + MONOF;
    var vlines = ctxWrap(ctx, verdict, CW).slice(0,5);

    var total = EYE_H+GAP_EYE+SCORE_H+GAP_SCORE+rlines.length*RANK_LH+GAP_RANK+RULE_H+GAP_RULE+vlines.length*V_LH;
    var TOP = 390, BOT = 1520;
    var y = TOP + Math.max(0, (BOT-TOP-total)/2);

    ctx.fillStyle = MUTED; ctx.font = '29px ' + MONOF;
    trackedC(ctx, eye, CX, y, 11); y += EYE_H + GAP_EYE;

    ctx.fillStyle = YELLOW; ctx.font = '200px ' + BLACKF;
    ctx.fillText(score, CX - ctx.measureText(score).width/2, y); y += SCORE_H + GAP_SCORE;

    ctx.fillStyle = INK; ctx.font = RANK_SZ + 'px ' + BLACKF;
    for (var i=0;i<rlines.length;i++){
      ctx.fillText(rlines[i], CX - ctx.measureText(rlines[i]).width/2, y); y += RANK_LH;
    }
    y += GAP_RANK;

    ctx.fillStyle = RED; ctx.fillRect(CX-80, y, 160, RULE_H); y += RULE_H + GAP_RULE;

    ctx.fillStyle = MUTED; ctx.font = '35px ' + MONOF;
    for (var j=0;j<vlines.length;j++){
      ctx.fillText(vlines[j], CX - ctx.measureText(vlines[j]).width/2, y); y += V_LH;
    }

    ctx.fillStyle = RED; ctx.fillRect(0, 1610, W, 8);
    ctx.fillStyle = INK; ctx.font = '64px ' + BLACKF;
    var cta = "HAZ EL TEST";
    ctx.fillText(cta, CX - ctx.measureText(cta).width/2, 1690);
    ctx.fillStyle = MUTED; ctx.font = '31px ' + MONOF;
    trackedC(ctx, "COASURF.COM/18", CX, 1790, 9);

    cardReady = true;
  }

  function buildCard(){
    if (!logoImg){
      logoImg = new Image();
      logoImg.onload = function(){ loadFont(paintCard); };
      logoImg.onerror = function(){ loadFont(paintCard); };
      logoImg.src = COA_LOGO;
    } else {
      loadFont(paintCard);
    }
  }

  var CORTA = "https://coasurf.com/18";
  var clink = el("copylink");
  if (clink) clink.addEventListener("click", function(){
    var ok = function(){
      clink.textContent = "Link copiado";
      setTimeout(function(){ clink.textContent = "Copiar el link"; }, 2500);
    };
    if (navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(CORTA).then(ok, ok);
    } else {
      var ta = document.createElement("textarea");
      ta.value = CORTA; ta.setAttribute("readonly","");
      ta.style.position = "absolute"; ta.style.left = "-9999px";
      document.body.appendChild(ta); ta.select();
      try { document.execCommand("copy"); } catch(e){}
      document.body.removeChild(ta); ok();
    }
  });

  var save = el("savecard");
  if (save) save.addEventListener("click", function(){
    var cv = el("canvas"); if (!cv || !cv.toBlob) return;
    if (!cardReady) paintCard();
    var nombre = "coa-test-del-18-" + hits + "-de-10.png";
    cv.toBlob(function(blob){
      if (!blob) return;
      try {
        var f = new File([blob], nombre, {type:"image/png"});
        if (navigator.canShare && navigator.canShare({files:[f]}) && navigator.share){
          navigator.share({files:[f], text:shareText()}).catch(function(){});
          return;
        }
      } catch(e){}
      var u = URL.createObjectURL(blob);
      var a = document.createElement("a");
      a.href = u; a.download = nombre;
      document.body.appendChild(a); a.click();
      setTimeout(function(){ document.body.removeChild(a); URL.revokeObjectURL(u); }, 1500);
      save.textContent = "Guardada";
      setTimeout(function(){ save.textContent = "Guardar mi resultado"; }, 2500);
    }, "image/png");
  });

  best = readBest();
  if(best!==null){
    var ri=el("recIntro");
    var iv=readNum("coa18_intentos");
    ri.textContent="Tu récord: "+best+" de 10"+(iv?" · "+iv+(iv===1?" intento":" intentos"):"");
    ri.style.display="";
  }
  if (location.hash === "#test18" || /[?&]ir=test/.test(location.search)){
    build(); render(); go("quiz");
  }
})();
</script>
