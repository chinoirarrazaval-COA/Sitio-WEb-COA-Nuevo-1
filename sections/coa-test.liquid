{%- comment -%}
  Test del coa — seccion COA
  Vive dentro de /pages/jerga-coa, ARRIBA del listado de palabras.
  El listado de palabras se queda como texto plano abajo: es lo que Google indexa.
{%- endcomment -%}

{% raw %}
<style>
  .coatest{
    --ct-ground:#131110; --ct-surface:#1c1917; --ct-surface2:#262220;
    --ct-line:#38312d; --ct-ink:#f0ebe6; --ct-muted:#948a83;
    --ct-red:#e22120; --ct-yellow:#f4d400;
    background:var(--ct-ground); color:var(--ct-ink);
    font-family:"Chivo","Helvetica Neue",Arial,sans-serif;
    line-height:1.55; padding-inline:20px; padding-block:44px 52px;
  }
  .coatest *{box-sizing:border-box}
  .coatest__wrap{max-width:560px;margin:0 auto}
  .coatest p{margin:0}
  .coatest a{color:var(--ct-ink)}
  .coatest :focus-visible{outline:2px solid var(--ct-yellow);outline-offset:3px}

  .ct-eyebrow{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--ct-muted);margin:0;font-family:ui-monospace,Menlo,monospace}
  .ct-h1{font-weight:900;font-size:clamp(34px,10vw,54px);line-height:.95;letter-spacing:-.02em;margin:10px 0 0;color:var(--ct-ink)}
  .ct-h1 span{color:var(--ct-red)}
  .ct-lede{color:var(--ct-muted);font-size:16px;margin-top:16px;max-width:44ch}

  .coatest button{font-family:inherit;font-size:inherit;cursor:pointer}
  .ct-btn{display:block;width:100%;background:var(--ct-red);color:#fff;border:0;padding:17px 20px;font-weight:900;font-size:15px;letter-spacing:.08em;text-transform:uppercase;transition:filter .15s ease}
  .ct-btn:hover{filter:brightness(1.12)}
  .ct-btn--ghost{background:transparent;color:var(--ct-ink);border:1px solid var(--ct-line);font-weight:700}
  .ct-btn--ghost:hover{background:var(--ct-surface2);filter:none}

  .ct-tally{display:flex;gap:14px;align-items:flex-end;height:30px}
  .ct-tally svg{display:block;overflow:visible}
  .ct-tally .s{stroke:var(--ct-line);stroke-width:2.6;stroke-linecap:round}
  .ct-tally .s.on{stroke:var(--ct-ink)}
  .ct-tally .s.now{stroke:var(--ct-yellow)}
  .ct-meta{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:30px}
  .ct-meta .r{text-align:right}
  .ct-rec{display:block;margin-top:4px;font-size:10px;opacity:.7}

  .ct-word{font-family:ui-monospace,Menlo,monospace;font-weight:700;font-size:clamp(28px,8vw,42px);line-height:1.1;letter-spacing:-.02em;margin:0 0 6px;color:var(--ct-ink)}
  .ct-prompt{color:var(--ct-muted);font-size:14px;margin-bottom:22px}

  .ct-opts{display:flex;flex-direction:column;gap:10px}
  .ct-opt{position:relative;display:block;width:100%;text-align:left;background:var(--ct-surface);color:var(--ct-ink);border:1px solid var(--ct-line);padding:15px 17px;font-size:16px;line-height:1.4;transition:background .12s,border-color .12s}
  .ct-opt:hover:not(:disabled){background:var(--ct-surface2);border-color:#4a423d}
  .ct-opt:disabled{cursor:default}
  .ct-opt.ok{border-color:var(--ct-yellow);background:#241f0c;color:var(--ct-yellow);font-weight:700}
  .ct-opt.ok::before,.ct-opt.ok::after{content:"";position:absolute;top:9px;bottom:9px;width:3px;background:var(--ct-yellow)}
  .ct-opt.ok::before{left:5px} .ct-opt.ok::after{right:5px}
  .ct-opt.bad{border-color:var(--ct-red);color:#e88a89;background:#251110}
  .ct-opt .tg{font-family:ui-monospace,Menlo,monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;display:block;margin-top:5px;opacity:.85}

  .ct-after{margin-top:18px;display:none}
  .ct-after.show{display:block}
  .ct-note{border-left:2px solid var(--ct-line);padding:2px 0 2px 14px;color:var(--ct-muted);font-size:14px;margin-bottom:16px}
  .ct-note .use{display:block;margin-top:7px;font-style:italic;color:#b3a89f}
  .ct-note .tie{display:block;margin-top:10px;font-family:ui-monospace,Menlo,monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ct-yellow)}
  .ct-note .tie a{color:var(--ct-yellow)}

  .ct-rank{font-weight:900;font-size:clamp(38px,11vw,62px);line-height:.92;letter-spacing:-.025em;margin:12px 0 0;color:var(--ct-yellow)}
  .ct-score{font-family:ui-monospace,Menlo,monospace;font-size:15px;color:var(--ct-muted);margin-top:14px}
  .ct-score b{color:var(--ct-ink);font-size:22px}
  .ct-verdict{margin-top:18px;font-size:17px;max-width:42ch}

  .ct-panel{background:var(--ct-surface);border:1px solid var(--ct-line);padding:22px;margin-top:26px}
  .ct-panel h2{font-size:13px;font-family:ui-monospace,Menlo,monospace;letter-spacing:.16em;text-transform:uppercase;color:var(--ct-muted);margin:0 0 14px;font-weight:400}
  .ct-missed{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:14px}
  .ct-missed li{border-left:2px solid var(--ct-red);padding-left:14px}
  .ct-missed .w{font-family:ui-monospace,Menlo,monospace;font-weight:700;font-size:17px;display:block}
  .ct-missed .m{color:var(--ct-muted);font-size:15px}

  .ct-shop{list-style:none;margin:0;padding:0}
  .ct-shop li{border-top:1px solid var(--ct-line)}
  .ct-shop li:first-child{border-top:0}
  .ct-shop a{display:flex;justify-content:space-between;align-items:baseline;gap:14px;padding:14px 0;text-decoration:none}
  .ct-shop a:hover .w{color:var(--ct-yellow)}
  .ct-shop .w{font-family:ui-monospace,Menlo,monospace;font-weight:700;font-size:16px}
  .ct-shop .m{color:var(--ct-muted);font-size:13px;text-align:right;flex:none}

  .coatest label{display:block;font-size:14px;margin-bottom:7px;color:var(--ct-muted)}
  .coatest input[type=email],.coatest input[type=text]{width:100%;background:var(--ct-ground);border:1px solid var(--ct-line);color:var(--ct-ink);font-family:inherit;font-size:16px;padding:14px 15px;border-radius:0}
  .coatest input::placeholder{color:#5f5751}
  .coatest input:focus{border-color:var(--ct-yellow);outline:none}
  .ct-consent{display:flex;gap:10px;align-items:flex-start;margin:16px 0 20px;font-size:13px;color:var(--ct-muted);line-height:1.45}
  .ct-consent input{margin-top:3px;accent-color:var(--ct-red);flex:none;width:16px;height:16px}
  .ct-err{color:#e88a89;font-size:13px;margin-top:10px;display:none}
  .ct-err.show{display:block}
  .ct-code{font-family:ui-monospace,Menlo,monospace;font-weight:700;font-size:clamp(22px,6vw,30px);letter-spacing:.1em;color:var(--ct-yellow);border:1px dashed var(--ct-yellow);padding:16px;text-align:center;margin:4px 0 16px}
  .ct-share{margin-top:12px;font-size:14px;color:var(--ct-muted)}

  .ct-foot{margin-top:36px;padding-top:22px;border-top:1px solid var(--ct-line);font-size:13px;color:var(--ct-muted);line-height:1.6}
  .ct-foot strong{color:var(--ct-ink);font-weight:700}

  .ct-screen{display:none}
  .ct-screen.on{display:block}
  @media (prefers-reduced-motion:reduce){.coatest *{transition:none!important}}

  .ct-cardbox{text-align:center}
  .ct-cardbox canvas{width:100%;max-width:236px;height:auto;display:block;margin:0 auto 16px;border:1px solid var(--ct-line);background:var(--ct-ground)}
  .ct-cardhint{font-size:14px;color:var(--ct-muted);margin-top:12px!important}
  .ct-cardhint b{color:var(--ct-ink)}
</style>

<div class="coatest" id="coatest"><span id="test" aria-hidden="true"></span>
  <div class="coatest__wrap">

    <section class="ct-screen on" data-s="intro">
      <p class="ct-eyebrow">Diccionario COA · Test</p>
      <p class="ct-h1">¿Cachái<br>el <span>coa</span>?</p>
      <p class="ct-lede">Diez palabras de la jerga carcelaria chilena. Cuatro opciones cada una. Nadie saca diez a la primera — y al final te llevas un 15% de descuento.</p>
      <p class="ct-eyebrow" data-el="recIntro" style="margin-top:22px;display:none"></p>
      <div style="margin-top:30px"><button class="ct-btn" data-el="start" type="button">Empezar el test</button></div>
      <p class="ct-foot" style="margin-top:26px;padding-top:0;border:0">Toma menos de dos minutos. Y si te aburre, el diccionario completo está más abajo.<br><br><strong>Las preguntas cambian cada vez.</strong> Son diez sacadas de un banco de 36, así que no le pidas las respuestas a nadie: no le van a servir.</p>
    </section>

    <section class="ct-screen" data-s="quiz">
      <div class="ct-meta">
        <div>
          <p class="ct-eyebrow" data-el="qnum">Palabra 1 de 10</p>
          <div class="ct-tally" data-el="tally" aria-hidden="true"></div>
        </div>
        <div class="r">
          <p class="ct-eyebrow" data-el="hits">0 buenas</p>
          <p class="ct-eyebrow ct-rec" data-el="recLive"></p>
        </div>
      </div>
      <p class="ct-word" data-el="word">—</p>
      <p class="ct-prompt">¿Qué significa?</p>
      <div class="ct-opts" data-el="opts"></div>
      <div class="ct-after" data-el="after">
        <p class="ct-note" data-el="note"></p>
        <button class="ct-btn" data-el="next" type="button">Siguiente</button>
      </div>
    </section>

    <section class="ct-screen" data-s="result">
      <p class="ct-eyebrow">Tu resultado</p>
      <p class="ct-rank" data-el="rank">—</p>
      <p class="ct-score"><b data-el="final">0</b> de 10 correctas <span data-el="recNote"></span></p>
      <p class="ct-verdict" data-el="verdict"></p>

      <div class="ct-panel" data-el="missedBox" style="display:none">
        <h2>Las que se te escaparon</h2>
        <ul class="ct-missed" data-el="missed"></ul>
      </div>

      <div class="ct-panel" data-el="prize">
        <h2>Llévate tu resultado</h2>
        <p style="font-size:16px;margin-bottom:20px" data-el="prizeText"></p>
        <label for="ct-mail">Tu correo</label>
        <input type="email" id="ct-mail" placeholder="tunombre@correo.cl" autocomplete="email">
        <div class="ct-consent">
          <input type="checkbox" id="ct-ok">
          <label for="ct-ok" style="margin:0">Quiero mi tarjeta, mi código y las novedades de COA. Puedo salirme cuando quiera.</label>
        </div>
        <button class="ct-btn" data-el="claim" type="button">Mostrarme mi resultado</button>
        <p class="ct-err" data-el="err"></p>
      </div>

      <div class="ct-panel" data-el="reveal" style="display:none">
        <h2>Ahí está</h2>
        <p class="ct-code" data-el="codeBox">COA15</p>
        <p style="font-size:15px;color:var(--ct-muted);margin-bottom:18px">Válido en toda la tienda, un uso por persona. Anótalo o sácale una foto.</p>
        <a class="ct-btn" href="/collections/all" style="text-align:center;text-decoration:none">Ir a la tienda</a>
        <p class="ct-share">Sacaste <b data-el="shareScore">0</b>/10. <button data-el="copy" type="button" style="background:none;border:0;color:var(--ct-yellow);padding:0;text-decoration:underline;font-size:14px">Compartir</button>
        &nbsp;·&nbsp; <button data-el="wsp" type="button" style="background:none;border:0;color:var(--ct-yellow);padding:0;text-decoration:underline;font-size:14px">Mandar por WhatsApp</button></p>
      </div>

      <div class="ct-panel ct-cardbox" data-el="cardbox" style="display:none">
        <h2>Muéstralo</h2>
        <canvas data-el="canvas" width="1080" height="1920" aria-label="Tu resultado del test del coa"></canvas>
        <button class="ct-btn" data-el="savecard" type="button">Guardar mi resultado</button>
        <button class="ct-btn ct-btn--ghost" data-el="copylink" type="button" style="margin-top:10px">Copiar el link</button>
        <p class="ct-cardhint">Súbela a tu historia, ponle el <b>sticker de link</b> con el link copiado y etiqueta a <b>@coa.chile</b>. El que la ve, la juega.</p>
      </div>

      <div class="ct-panel">
        <h2>Estas palabras andan puestas</h2>
        <p style="font-size:15px;color:var(--ct-muted);margin-bottom:16px">Cinco de las que salieron están estampadas en una polera, y una le da el nombre a un plan de aporte mensual. No es casualidad: los diseños salieron de ahí.</p>
        <ul class="ct-shop">
          <li><a href="/products/polera-anti-perkin-negro"><span class="w">Perkin</span><span class="m">Polera Anti Perkin</span></a></li>
          <li><a href="/products/polera-encierro-negra"><span class="w">Los cinco puntos</span><span class="m">Polera Encierro</span></a></li>
          <li><a href="/products/polera-dias-contado-gris"><span class="w">Contar los días</span><span class="m">Polera Días Contado</span></a></li>
          <li><a href="/products/polera-destacador-gris"><span class="w">El destacador</span><span class="m">Polera Símbolo Destacador</span></a></li>
          <li><a href="/products/polera-cicatriz-gris"><span class="w">La cicatriz</span><span class="m">Polera Cicatriz</span></a></li>
          <li><a href="/products/plan-pa-coronar-20-000"><span class="w">Coronar</span><span class="m">Plan pa Coronar · aporte mensual</span></a></li>
        </ul>
      </div>

      <div class="ct-panel">
        <h2>El diccionario lo hacen ustedes</h2>
        <p style="font-size:15px;color:var(--ct-muted);margin-bottom:18px">¿Sabes una que no está? Déjala acá. Las que más se repitan las vamos a estampar en una polera — y quien la propuso queda con nombre y apellido en la etiqueta.</p>
        <div data-el="propForm">
          <label for="ct-np">La palabra</label>
          <input type="text" id="ct-np" placeholder="pituto" maxlength="40" autocomplete="off">
          <label for="ct-ns" style="margin-top:14px">Qué significa</label>
          <input type="text" id="ct-ns" placeholder="un contacto que te consigue algo" maxlength="140" autocomplete="off">
          <label for="ct-nm" style="margin-top:14px">Tu correo</label>
          <input type="email" id="ct-nm" placeholder="tunombre@correo.cl" autocomplete="email">
          <button class="ct-btn ct-btn--ghost" data-el="send" type="button" style="margin-top:16px">Proponer palabra</button>
          <p class="ct-err" data-el="propErr"></p>
        </div>
        <p class="ct-eyebrow" data-el="propOk" style="margin-top:16px;display:none;color:var(--ct-yellow)"></p>
      </div>

      <p class="ct-foot">
        <strong>El coa cambia a propósito.</strong> Cuando una palabra se hace conocida afuera, adentro se reemplaza. Por eso este diccionario nunca está terminado.
        <br><br>
        <button class="ct-btn ct-btn--ghost" data-el="again" type="button" style="margin-top:6px">Jugar de nuevo</button>
      </p>
    </section>

  </div>
</div>

