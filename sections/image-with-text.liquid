        },
        {
          "type": "range",
          "id": "caption_size",
          "label": "Text size",
          "unit": "px",
          "min": 1,
          "max": 52,
          "step": 1,
          "default": 18
        },
        {
          "type": "range",
          "id": "mobile_caption_size",
          "label": "Mobile Text size",
          "unit": "px",
          "min": 1,
          "max": 52,
          "step": 1,
          "default": 14
        },
        {
          "type": "color",
          "id": "caption_color",
          "label": "Text color",
          "default": "#000"
        },
        {
          "type": "color",
          "id": "highlighted_color",
          "label": "Highlighted color",
          "default": "#000"
        },
        {
          "type": "range",
          "id": "highlighted_font_size",
