        },
        {
          "type": "range",
          "id": "heading_size",
          "label": "Text size",
          "unit": "px",
          "min": 1,
          "max": 52,
          "step": 1,
          "default": 32
        },
        {
          "type": "range",
          "id": "mobile_heading_size",
          "label": "Mobile Text size",
          "unit": "px",
          "min": 1,
          "max": 52,
          "step": 1,
          "default": 18
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Text color",
          "default": "#000"
        },
        {
          "type": "select",
          "id": "heading_weight",
          "label": "Heading font weight",
          "options": [
            {
              "value": "normal",
              "label": "Normal"
            },
            {
              "value": "bold",
              "label": "Bold"
            }
          ],
          "default": "normal"
        }
      ]
    },
    {
      "type": "caption",
      "name": "t:sections.image-with-text.blocks.caption.name",
      "limit": 1,
      "settings": [
