<style>
  {{ selector }} {
    position: relative;
  }
  {{ selector }} > * {
    z-index: 1;
  }
  {{ selector }}::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background: {{ section.settings.pattern_bg_color }};
    mask-image: url({{ section.settings.pattern_bg | img_url: 'master' }});
    mask-size: 100%;
    mask-position: {{section.settings.pattern_bg_position }};
    mask-image-repeat: no-repeat;
    -webkit-mask-image: url({{ section.settings.pattern_bg | img_url: 'master' }});
    -webki-mask-size: 100%;
    -webkit-mask-position: {{section.settings.pattern_bg_position }};
    -webkit-mask-repeat: no-repeat;
    z-index: 0;
  }
</style>