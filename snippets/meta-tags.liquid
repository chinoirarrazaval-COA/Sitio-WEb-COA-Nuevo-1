{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  comment
    IMAGEN PARA COMPARTIR (WhatsApp, Facebook, X, LinkedIn).
    1. Producto, coleccion o articulo: se usa su propia imagen, siempre que
       mida al menos 800px de ancho. Bajo eso WhatsApp muestra una miniatura
       chica en vez de una tarjeta grande.
    2. Cualquier otra pagina: una tarjeta 1200x630 hecha a medida.
    3. Si no calza ninguna: la tarjeta por defecto de COA.
    NO se usa page_image a secas porque Shopify lo rellena con la imagen
    global de Preferencias y termina saliendo la misma foto en todo el sitio.
    Para cambiar una tarjeta: subirla a Configuracion > Archivos con el MISMO nombre.
  endcomment

  assign og_src = nil
  if request.page_type == 'product' and product.featured_media != blank
    assign og_src = product.featured_media.preview_image
  elsif request.page_type == 'collection' and collection.image != blank
    assign og_src = collection.image
  elsif request.page_type == 'article' and article.image != blank
    assign og_src = article.image
  endif

  if og_src and og_src.width < 800
    assign og_src = nil
  endif

  assign og_img = ''
  assign og_img_w = 1200
  assign og_img_h = 630
  assign og_img_alt = og_title

  if og_src
    assign og_img = og_src | image_url: width: 1200
    assign _w = og_src.width
    assign _h = og_src.height
    if _w > 1200
      assign og_img_h = _h | times: 1200 | divided_by: _w
      assign og_img_w = 1200
    else
      assign og_img_w = _w
      assign og_img_h = _h
    endif
    if og_src.alt != blank
      assign og_img_alt = og_src.alt
    endif
  endif

  if og_img == blank
    assign share_file = 'COA-share-default.jpg'
    if request.page_type == 'page'
      case page.handle
        when 'que-tan-chileno-eri'
          assign share_file = 'COA-share-test.jpg'
        when 'jerga-coa'
          assign share_file = 'COA-share-diccionario.jpg'
        when 'que-es-coa'
          assign share_file = 'COA-share-diccionario.jpg'
      endcase
    endif
    assign og_img = share_file | file_url
    assign og_img_w = 1200
    assign og_img_h = 630
  endif

  unless og_img contains 'https:'
    assign og_img = og_img | prepend: 'https:'
  endunless

  assign og_description = og_description | strip_html | strip | truncate: 190
-%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:locale" content="es_CL">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

<meta property="og:image" content="{{ og_img }}">
<meta property="og:image:secure_url" content="{{ og_img }}">
<meta property="og:image:width" content="{{ og_img_w }}">
<meta property="og:image:height" content="{{ og_img_h }}">
<meta property="og:image:alt" content="{{ og_img_alt | escape }}">

{%- if request.page_type == 'product' -%}
  {%- liquid
    assign og_variant = product.selected_or_first_available_variant
    assign og_price = og_variant.price | money_without_currency | strip_html | replace: ',', ''
  -%}
  <meta property="og:price:amount" content="{{ og_price }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:price:amount" content="{{ og_price }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
  <meta property="product:condition" content="new">
  {%- if product.vendor != blank -%}
    <meta property="product:brand" content="{{ product.vendor | escape }}">
  {%- endif -%}
  {%- if og_variant.sku != blank -%}
    <meta property="product:retailer_item_id" content="{{ og_variant.sku | escape }}">
  {%- endif -%}
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
<meta name="twitter:image" content="{{ og_img }}">
<meta name="twitter:image:alt" content="{{ og_img_alt | escape }}">
