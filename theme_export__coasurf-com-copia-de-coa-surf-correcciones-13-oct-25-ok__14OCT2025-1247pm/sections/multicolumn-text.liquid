        },
        {
          "type": "select",
          "id": "text_weight",
          "label": "Text font weight",
          "options": [
            {
              "value": "normal",
              "label": "Normal"
            },
            {
              "value": "bold",
              "label": "Bold"
            }
          ],
          "default": "normal"
        },
        {
          "type": "color",
          "id": "text_color",
