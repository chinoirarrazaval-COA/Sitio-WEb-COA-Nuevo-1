        {
          "type": "header",
          "content": "Title settings"
        },
        {
          "type": "text",
          "id": "title",
          "default": "Column",
          "label": "t:sections.multicolumn.blocks.column.settings.title.label"
        },
        {
          "type": "select",
          "id": "title_weight",
          "label": "Title font weight",
          "options": [
            {
              "value": "normal",
              "label": "Normal"
            },
            {
              "value": "bold",
              "label": "Bold"
            }
          ],
          "default": "normal"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title color",
          "default": "#000"
        },
        {
          "type": "range",
          "id": "title_size",
          "label": "Text size",
          "unit": "px",
          "min": 1,
          "max": 52,
          "step": 1,
          "default": 24
        },
        {
          "type": "range",
          "id": "title_mobile_size",
          "label": "Mobile Text mobile size",
          "unit": "px",
          "min": 1,
          "max": 52,
          "step": 1,
          "default": 18
