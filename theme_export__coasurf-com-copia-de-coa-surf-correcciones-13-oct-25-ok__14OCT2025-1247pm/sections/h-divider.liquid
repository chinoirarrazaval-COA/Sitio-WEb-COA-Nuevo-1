<div class="wave-border-wrapper">
  {% if section.settings.enable_wave_border %}
    {% render 'wave-border', wave_color: section.settings.wave_border_color %}
  {% endif %}
  <section style="display: block; padding: {{ section.settings.spacing-t }}px 0 {{ section.settings.spacing-b }}px;">
    {% if section.settings.enable-line %}
    <div
      {% unless section.settings.full-width  %}class="page-width"{% endunless %}
      style="display: block; border-bottom: 1px solid {{ section.settings.line-color }}"
    ></div>
    {% endif %}
    {% if section.settings.texture != blank %}
      <img
        src="{{ section.settings.texture | img_url: 'master' }}"
        alt="{{ section.settings.texture.alt }}"
        class="section-divider"
        style="
          width: 100%;
          display: block;
        "
      >
    {% endif %}
  </section>
</div>
{% schema %}
{
  "name": "H - Divider",
  "settings": [
    {
      "type": "image_picker",
      "id": "texture",
      "label": "Pattern image"
    },
    {
      "type": "header",
      "content": "Wave Border"
    },
    {
      "type": "checkbox",
      "id": "enable_wave_border",
      "label": "Enable wave border",
      "default": false
    },
    {
      "type": "color",
      "id": "wave_border_color",
      "label": "wave border color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "spacing-t",
      "label": "Top Spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "spacing-b",
      "label": "Bottom Spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "enable-line",
      "label": "Enable line"
    },
    {
      "type": "color",
      "id": "line-color",
      "label": "Line color",
      "default": "#ccc"
    },
    {
      "type": "checkbox",
      "id": "full-width",
      "label": "Full width line"
    }
  ],
  "presets": [
    {"name": "H - Divider"}
  ]
}
{% endschema %}